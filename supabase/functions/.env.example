# Copie este archivo como .env solo para desarrollo local. Nunca lo suba al repositorio.
EVOLUTION_API_URL=https://evolution.su-dominio.com
EVOLUTION_API_KEY=reemplazar_api_key_evolution
EVOLUTION_INSTANCE_NAME=dental-americana
EVOLUTION_WEBHOOK_SECRET=reemplazar_secreto_webhook_minimo_24_caracteres
WHATSAPP_CRON_SECRET=reemplazar_secreto_cron_largo
# Si el dominio de Evolution está protegido por Cloudflare Access, configurar ambos.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# El envío de datos clínicos a IA externa permanece apagado salvo aprobación explícita.
# Los campos de texto libre pueden contener datos personales; revisar consentimiento y contrato.
EXTERNAL_AI_ENABLED=false
# Gemini opcional. Con el interruptor apagado, el copiloto usa el borrador estructurado local.
GEMINI_API_KEY=reemplazar_api_key_gemini
GEMINI_MODEL=gemini-2.5-flash

# Proveedor OpenAI-compatible alternativo (opcional).
AI_API_KEY=reemplazar_clave_del_proveedor
AI_API_URL=https://api.example.com/v1/chat/completions
AI_MODEL=reemplazar_modelo
