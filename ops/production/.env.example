# Copiar como .env. Nunca subir este archivo con valores reales.
# Fijar digests reales (no etiquetas :latest). Verificar versiones compatibles antes de desplegar.
NODE_IMAGE=node:22-alpine@sha256:REEMPLAZAR_DIGEST
NGINX_IMAGE=nginx:1.30-alpine@sha256:REEMPLAZAR_DIGEST
EVOLUTION_IMAGE=evoapicloud/evolution-api@sha256:REEMPLAZAR_DIGEST
POSTGRES_IMAGE=postgres:15-alpine@sha256:REEMPLAZAR_DIGEST
REDIS_IMAGE=redis:7-alpine@sha256:REEMPLAZAR_DIGEST
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REEMPLAZAR_DIGEST

# Debe coincidir con src/environments/environment.ts del frontend.
SUPABASE_ORIGIN=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_WS_ORIGIN=wss://YOUR_PROJECT_REF.supabase.co
WEB_PUBLIC_ORIGIN=https://sistema.su-dominio.com
EVOLUTION_PUBLIC_ORIGIN=https://evolution.su-dominio.com

# Usar valores distintos de desarrollo; solo caracteres alfanuméricos en la clave DB
# porque se incluye en una URI PostgreSQL.
EVOLUTION_API_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES
EVOLUTION_DB_PASSWORD=REEMPLAZAR_CON_SECRETO_ALFANUMERICO_DE_40_CARACTERES
